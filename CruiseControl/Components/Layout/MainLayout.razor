@inherits LayoutComponentBase
@inject AccountStorage AccountStorage
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div class="page">
    <main>
        <div class="top-row px-4">
            <button class="btn btn-primary" @onclick="NavigateToDashboard">Dashboard</button>
            <button class="btn btn-primary" @onclick="NavigateToSignIn">Sign In/Out</button>
            <button class="btn btn-primary" @onclick="NavigateToProfile">Profile</button>
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private string loggedInUsername;
    private bool sidebarVisible = false;

    protected override void OnInitialized()
    {
        sidebarVisible = false;
        loggedInUsername = AccountStorage.GetCurrentLoggedInUsername();
    }

    private void NavigateToDashboard()
    {
        NavigationManager.NavigateTo("/dashboard"); 
    }

    private void NavigateToSignIn()
    {
        AccountStorage.RemoveLoggedInUsername();
        NavigationManager.NavigateTo("/"); 
    }

    private void NavigateToProfile()
    {
        NavigationManager.NavigateTo("/profile"); 
    }

    private void ToggleSidebar()
    {
        sidebarVisible = !sidebarVisible;
    }
    private void SignOut()
    {
        AccountStorage.RemoveLoggedInUsername();
        loggedInUsername = null;
        StateHasChanged();
        NavigationManager.NavigateTo("/");
    }
}