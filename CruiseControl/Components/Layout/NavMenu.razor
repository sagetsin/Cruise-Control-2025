@inject AccountStorage AccountStorage
@inject NavigationManager NavigationManager

<nav>
    @if (string.IsNullOrEmpty(loggedInUsername))
    {
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/">
                <span class="oi oi-account-login" aria-hidden="true"></span> Sign In
            </NavLink>
        </div>
    }
    else
    {
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/profile">
                <span class="oi oi-person" aria-hidden="true"></span> Profile
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/dashboard">
                <span class="oi oi-dashboard" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <button class="nav-link btn btn-link" @onclick="SignOut">
                <span class="oi oi-account-logout" aria-hidden="true"></span> Sign Out
            </button>
        </div>
    }
</nav>


@code {
    private string loggedInUsername;

    protected override void OnInitialized()
    {
        loggedInUsername = AccountStorage.GetCurrentLoggedInUsername();
    }

    private void SignOut()
    {
        AccountStorage.RemoveLoggedInUsername();
        NavigationManager.NavigateTo("/"); // Navigate to sign-in page
    }

    protected override void OnParametersSet()
    {
        loggedInUsername = AccountStorage.GetCurrentLoggedInUsername();
    }
}