@page "/timer"
@using System.Timers
@inject AccountStorage AccountStorage
@inject NavigationManager NavigationManager

<h1>Hi!</h1>

<p>Elapsed Time: @FormatTime(elapsedMilliseconds)</p>
<p>Points: @FormatPoints()</p>

@if (isRunning)
{
    <button class="btn btn-danger" @onclick="Stop">End Trip</button>
}
else
{
    <button class="btn btn-primary" @onclick="Start">Start Driving</button>
}

@code {
    public System.Timers.Timer timer;
    private bool isRunning = false;
    private DateTime startTime;
    private long elapsedMilliseconds = 0;
    private string loggedInUsername;

    protected override void OnInitialized()
    {
        loggedInUsername = AccountStorage.GetCurrentLoggedInUsername();
        timer = new System.Timers.Timer(10);
        timer.Elapsed += OnTimerElapsed;
    }

    private void Start()
    {
        if (!isRunning)
        {
            startTime = DateTime.Now;
            timer.Start();
            isRunning = true;
        }
    }

    private void Stop()
    {
        if (isRunning)
        {
            timer.Stop();
            elapsedMilliseconds = 0;
            isRunning = false;
            InvokeAsync(StateHasChanged);
        }
    }
    private void OnTimerElapsed(object sender, System.Timers.ElapsedEventArgs e)
    {
        int interval = 1000;
        long pointCounter = 0;

    
        if (isRunning)
        {
            
            long deltaMilliseconds = (long)(DateTime.Now - startTime).TotalMilliseconds; // Calculate the time since last tick
            startTime = DateTime.Now;
            elapsedMilliseconds += deltaMilliseconds;
            pointCounter += elapsedMilliseconds;

            System.Console.WriteLine("Point Counter: " + pointCounter);

            // add points to user every pointDivisor milliseconds
            if (pointCounter >= interval)
            {
                System.Console.WriteLine("Adding points");
                // add points to user
                pointCounter -= interval; 
                // get points and add two
                int newPoints = AccountStorage.GetPoints(loggedInUsername) + 2;
                AccountStorage.SetPoints(loggedInUsername, newPoints);
            }
            InvokeAsync(StateHasChanged);
        }
    }

	private string FormatTime(long elapsedMilliseconds)
	{
		TimeSpan timeSpan = TimeSpan.FromMilliseconds(elapsedMilliseconds);
		return timeSpan.ToString(@"hh\:mm\:ss");
	}

    private string FormatPoints()
    {
        int points = AccountStorage.GetPoints(loggedInUsername);
        return points.ToString();
    }

    public void Dispose()
    {
        timer?.Dispose();
    }

}
