@page "/creategroup"
@inject NavigationManager NavigationManager
@inject AccountStorage AccountStorage
@inject GroupStorage GroupStorage
@inject IJSRuntime JSRuntime

<h3>Create Group</h3>


@if (string.IsNullOrEmpty(loggedInUsername)){
    <p>You must be logged in to create a group.</p>
    <button class="btn btn-secondary" @onclick="NavigateToSignIn">Sign In</button>
}
else
{
    <div class="form-group">
        <label>Group Name:</label>
        <input type="text" class="form-control" @bind="groupName" />
    </div>

    <button class="btn btn-primary" @onclick="CreateNewGroup">Create Group</button>
    <button class="btn btn-secondary" @onclick="NavigateToManageGroups">Manage Groups</button>

    @if (!string.IsNullOrEmpty(createGroupMessage))
    {
        <p>@createGroupMessage</p>
    }
    @if (!string.IsNullOrEmpty(groupCode))
    {
        <p>Group Code: @groupCode</p>
        <button class="btn btn-outline-primary" @onclick="CopyToClipboard">Copy Code</button>

        @if (!string.IsNullOrEmpty(copyMessage))
        {
            <p>@copyMessage</p>
        }
    }
}

@code {
    private string groupName;
    private string createGroupMessage;
    private string loggedInUsername;
    private string groupCode;
    private string copyMessage;


    protected override void OnInitialized()
    {
        loggedInUsername = AccountStorage.GetCurrentLoggedInUsername();
        if (loggedInUsername == null)
        {
            return;
        }
    }

    private void CreateNewGroup()
    {
        if (!string.IsNullOrEmpty(groupName))
        {
            var result = GroupStorage.CreateGroup(groupName, loggedInUsername);
            createGroupMessage = result.message;
            groupCode = result.groupCode;
            groupName = "";
        }
        else
        {
            createGroupMessage = "Please enter a group name.";
        }
    }

    private async Task CopyToClipboard()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", groupCode);
            copyMessage = "Group code copied to clipboard!";
        }
        catch (Exception ex)
        {
            copyMessage = $"Failed to copy: {ex.Message}";
        }
    }

    private void NavigateToSignIn()
    {
        NavigationManager.NavigateTo("/");
    }
    private void NavigateToManageGroups()
    {
        NavigationManager.NavigateTo("/managegroups");
    }
}