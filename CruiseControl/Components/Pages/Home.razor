@page "/"

@page "/signin"

<h3>Sign In</h3>

<div class="form-group">
    <label>Username:</label>
    <input type="text" class="form-control" @bind="username" />
</div>

<div class="form-group">
    <label>Password:</label>
    <input type="password" class="form-control" @bind="password" />
</div>

<button class="btn btn-primary" @onclick="SignIn">Sign In</button>

@if (!string.IsNullOrEmpty(signInMessage))
{
    <p>@signInMessage</p>
}

@code {
    private string username;
    private string password;
    private string signInMessage;

    private void SignIn()
    {
        // Here, you would typically perform authentication logic,
        // such as sending the username and password to a backend API.
        // For this example, we'll just store the values in variables.

        if (!string.IsNullOrEmpty(username) && !string.IsNullOrEmpty(password))
        {
            signInMessage = $"Username: {username}, Password: {password} (Stored in variables)";

            // In a real app, you would do something like:
            // var response = await Http.PostAsJsonAsync("api/signin", new { username, password });
            // if (response.IsSuccessStatusCode) { ... } else {...}

            // You can now use the username and password variables as needed.
            // For example, you might store them in local storage or
            // use them to make further API requests.
        }
        else
        {
            signInMessage = "Please enter a username and password.";
        }
    }
}