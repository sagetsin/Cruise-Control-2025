@page "/"
@inject NavigationManager NavigationManager
@inject AccountStorage AccountStorage // Inject AccountStorage


<h3>Sign In</h3>

<div class="form-group">
    <label>Username:</label>
    <input type="text" class="form-control" @bind="username" />
</div>

<div class="form-group">
    <label>Password:</label>
    <input type="password" class="form-control" @bind="password" />
</div>

<button class="btn btn-primary" @onclick="SignIn">Sign In</button>
<button class="btn btn-secondary" @onclick="NavigateToCreateAccount">Create Account</button>

@if (!string.IsNullOrEmpty(signInMessage))
{
    <p>@signInMessage</p>
}

@code {
    private string username;
    private string password;
    private string signInMessage;

    private void SignIn()
    {
        if (!string.IsNullOrEmpty(username) && !string.IsNullOrEmpty(password))
        {
            List<AccountStorage.Account> accounts = AccountStorage.LoadAccounts(); // Load accounts

            AccountStorage.Account foundAccount = accounts.FirstOrDefault(a => a.Username == username);

            if (foundAccount != null && foundAccount.Password == password) // Replace with password hashing!
            {
                signInMessage = "Sign in successful!";
                NavigateToDashboard();
                // Perform actions after successful ssgn-in (e.g., navigate to another page)
            }
            else
            {
                signInMessage = "Invalid username or password.";
            }
        }
        else
        {
            signInMessage = "Please enter a username and password.";
        }
    }

    private void NavigateToCreateAccount()
    {
        NavigationManager.NavigateTo("/createaccount");
    }

    private void NavigateToDashboard()
    {
        NavigationManager.NavigateTo("/dashboard");
    }
}