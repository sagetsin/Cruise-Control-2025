@page "/createaccount"
@inject NavigationManager NavigationManager
@inject AccountStorage AccountStorage

<h3>Create Account</h3>

<div class="form-group">
    <label>Username:</label>
    <input type="text" class="form-control" @bind="username" />
</div>

<div class="form-group">
    <label>Password:</label>
    <input type="password" class="form-control" @bind="password" />
</div>

<button class="btn btn-primary" @onclick="CreateAccount">Create Account</button>
<button class="btn btn-secondary" @onclick="NavigateToSignIn">Return to Sign In</button>


@if (!string.IsNullOrEmpty(resultMessage))
{
    <p>@resultMessage</p>
}

@code {
    private string username;
    private string password;
    private string resultMessage;

    private void CreateAccount()
    {
        if (!string.IsNullOrEmpty(username) && !string.IsNullOrEmpty(password))
        {
            AccountStorage.StoreAccount(username, password);
            resultMessage = "Credentials stored successfully.";
            username = "";
            password = "";
        }
        else
        {
            resultMessage = "Please enter both username and password.";
        }
    }

    private void NavigateToSignIn()
    {
        NavigationManager.NavigateTo("/");
    }
}