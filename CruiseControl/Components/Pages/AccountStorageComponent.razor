@page "/createaccount"
@inject NavigationManager NavigationManager
@inject AccountStorage AccountStorage

<h3>Create Account</h3>

<div class="form-group">
    <label>Username:</label>
    <input type="text" class="form-control" @bind="username" />
</div>

<div class="form-group">
    <label>Password:</label>
    <input type="password" class="form-control" @bind="password" />
</div>

<button class="btn btn-primary" @onclick="CreateAccount">Create Account</button>
<button class="btn btn-secondary" @onclick="NavigateToSignIn">Return to Sign In</button>


@if (!string.IsNullOrEmpty(resultMessage))
{
    <p>@resultMessage</p>
}

@code {
    private string username;
    private string password;
    private string resultMessage;

    private void CreateAccount()
    {
        if (string.IsNullOrEmpty(username) || string.IsNullOrEmpty(password))
        {
            resultMessage = "Please enter a username and password.";
            return;
        }

        var result = AccountStorage.StoreAccount(username, password);
        resultMessage = result.message;

        if (result.success)
        {
            // Optionally, sign in the user after successful sign-up
            AccountStorage.SetLoggedInUsername(username);
            NavigationManager.NavigateTo("/dashboard");
        }
    }

    private void NavigateToSignIn()
    {
        NavigationManager.NavigateTo("/");
    }
}